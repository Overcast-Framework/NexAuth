@page "/"
@inject NexAuth.WalletSession WalletSession
@inject NavigationManager Navigation

<div class="min-h-screen bg-base-100 text-base-content">
    <main class="mx-auto max-w-xl gap-4 p-6">
        @if(_showFailedLogin)
        {
            <div role="alert" class="alert alert-error">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Error! @_failedLoginReason</span>
            </div>            
        }
        <div class="card shadow-xl bg-base-200">
            <div class="card-body gap-2">
                <div class="flex flex-col justify-center items-center p-2">
                    <p class="font-sans text-base-content text-2xl pb-3">Enter your PIN code</p>
                    <fieldset class="fieldset">
                        <input type="password" class="input passwd_slot font-sans text-base-content" placeholder="Enter here..." @bind="_fieldLoginPin" />
                    </fieldset>
                </div>
                <button class="btn btn-primary font-sans text-base-100" @onclick="onLoginPressed">Unlock</button>
                <div class="divider text-base-content">OR</div>
                <button class="btn btn-secondary font-sans text-base-100" @onclick="toggleShowRegister">Register</button>
            </div>
        </div>

        @if(_showRegister)
        {
            <div class="divider"></div>
            <div class="card shadow-xl bg-base-200 p-6">
                <div class="card-body gap-2">
                    <div class="flex flex-col justify-center items-center gap-4 p-2">
                        <p class="font-sans text-base-content text-2xl pb-3">Create a PIN code</p>
                        <fieldset class="fieldset">
                            <input type="password" class="input passwd_slot font-sans text-base-content" placeholder="Enter here..." value="@_fieldCreatePin" @oninput="updatePin"/>
                        </fieldset>

                        @if (_showWarnWeak)
                        {
                            <div class="card border-1 border-error w-fit  bg-base-200 shadow-xl">
                                <div class="card-body p-2">
                                    <p class="font-sans text-base-content text-md">⛔ Your PIN code is too weak. Please select a stronger PIN code.</p>
                                </div>
                            </div>
                        }

                        <p class="font-sans text-base-content text-md">Estimated PIN code security score: @_pinSecurityScore (@_pinStrength.ToString().Replace("_", " "))</p>
                        <p class="font-sans text-center text-base-content text-md">Avoid using sequential/repeating digits, such as 123456, 111111, etc.</p>
                        <div class="card border-1 w-fit bg-base-200 shadow-xl">
                            <div class="card-body p-3">
                                <p class="font-sans text-base-content text-md">⚠️ Your PIN code cannot be restored, if it is lost.</p>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-primary font-sans text-base-100" @onclick="onCreatePressed">Create</button>
                </div>
            </div>
        }
    </main>
</div>

@code
{
    private bool _showRegister = false;
    private bool _showWarnWeak = false;
    private float _pinSecurityScore = 0;
    private StrengthCode _pinStrength = StrengthCode.Very_Weak;
    private string _fieldCreatePin = "";
    private string _fieldLoginPin = "";

    private bool _showFailedLogin = false;
    private string _failedLoginReason = "";

    public void toggleShowRegister()
    {
        _showRegister = !_showRegister;
    }

    private void onLoginPressed()
    {
        var err = NexAuth.SecureWallet.TryUnlock(_fieldLoginPin, out var wallet);

        if(err != NexAuth.UnlockFailureCode.Success)
        {
            _showFailedLogin = true;

            switch(err)
            {
                case NexAuth.UnlockFailureCode.WalletDoesNotExist:
                    _failedLoginReason = "No existing wallets were found. Please create a wallet first before logging in.";
                    break;
                case NexAuth.UnlockFailureCode.IncorrectPIN:
                    _failedLoginReason = "Unable to decrypt wallet. Potentially invalid credentials.";
                    break;
            }

            return;
        }

        WalletSession!.Unlock(wallet!);
        sendToDashboard();
    }

    private async void onCreatePressed()
    {
        if(_pinStrength == StrengthCode.Weak || _pinStrength == StrengthCode.Very_Weak)
        {
            _showWarnWeak = true;
            return;
        }

        if(File.Exists("wallet.json"))
        {
            _showFailedLogin = true;
            _failedLoginReason = "A wallet already exists!";
            return;
        }

        NexAuth.SecureWallet wallet = await NexAuth.SecureWallet.CreateWalletAsync(_fieldCreatePin);
        WalletSession!.Unlock(wallet!);

        sendToDashboard();
    }

    private void updatePin(ChangeEventArgs e)
    {
        _fieldCreatePin = e.Value?.ToString() ?? "";
        updateEntropy();
    }

    private void sendToDashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }

    private void updateEntropy()
    {
        _showWarnWeak = false;

        var uniqueAmount = _fieldCreatePin.Distinct().Count();
        var length = _fieldCreatePin.Length;

        var maxEntropy = length * Math.Log2(10);
        var diversity = (double)uniqueAmount / 10;

        _pinSecurityScore = (int)(maxEntropy * diversity);

        // I'll punish severely for the basic patterns that are easy to detect

        if (IsSequential(_fieldCreatePin))
        {
            _pinSecurityScore *= 0.2f;
        }
        if (_fieldCreatePin.Distinct().Count() == 1)
            _pinSecurityScore *= 0.2f;
        if (_fieldCreatePin.Contains("password"))
        {
            _pinSecurityScore *= 0.6f;
        }
        if (_fieldCreatePin.Contains("password123"))
        {
            _pinSecurityScore *= 0.6f;
        }
        if (_fieldCreatePin.Contains("passw0rd"))
        {
            _pinSecurityScore *= 0.6f;
        }
        if (_fieldCreatePin.Contains("1234567890"))
            _pinSecurityScore *= 0.1f;

        // mkay, that's enough

        if (_pinSecurityScore < 16)
        {
            _pinStrength = StrengthCode.Very_Weak;
        }
        if (_pinSecurityScore >= 16)
        {
            _pinStrength = StrengthCode.Weak;
        }
        if (_pinSecurityScore >= 22)
        {
            _pinStrength = StrengthCode.Normal;
        }
        if (_pinSecurityScore >= 33)
        {
            _pinStrength = StrengthCode.Strong;
        }
        if(_pinSecurityScore >= 39)
        {
            _pinStrength = StrengthCode.Very_Strong;
        }

        _pinSecurityScore = MathF.Floor(_pinSecurityScore);
    }

    bool IsSequential(string value)
    {
        if (value.Length < 3)
            return false;

        bool ascending = true;
        bool descending = true;

        for (int i = 1; i < value.Length; i++)
        {
            int diff = value[i] - value[i - 1];

            if (diff != 1)
                ascending = false;

            if (diff != -1)
                descending = false;
        }

        return ascending || descending;
    }

    private enum StrengthCode
    {
        Very_Weak,
        Weak,
        Normal,
        Strong,
        Very_Strong
    }
}