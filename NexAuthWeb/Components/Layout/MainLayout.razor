@inherits LayoutComponentBase

<div class="min-h-screen bg-base-100 text-base-content">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet class="alert alert-error fixed bottom-4 left-4 right-4 z-50 mx-auto max-w-xl shadow-lg">
    <span>An unhandled error has occurred.</span>
    <a href="." class="link">Reload</a>
    <button class="btn btn-sm btn-ghost" onclick="this.parentElement.style.display='none'">
        ✕
    </button>
</div>